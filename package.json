{
  "name": "pc-price-checker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js --watch server",
    "client": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install",
    "start": "npm run build && npm run server"
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
